# --- Server ---
PORT=8787
CLIENT_ORIGIN=http://localhost:5173

# --- MongoDB ---
# Local: mongodb://127.0.0.1:27017/repodna
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/repodna?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/repodna

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=30d

# --- Google Gemini (free tier, replaces OnSpace AI) ---
# Get a free key (no credit card required) at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-flash-latest

# --- Email (required for OTP login to actually verify anything) ---
# Without SMTP, OTP login can't prove someone owns the email address they
# typed — leave this unset and use password login instead (it's fully secure
# on its own). Only set ALLOW_OTP_DEV_FALLBACK=true if you specifically want
# to test the OTP screens yourself, locally, with nobody else able to reach
# this server — it prints/echoes the code back instead of emailing it, which
# means anyone with access to this server could log in as any email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RepoDNA <no-reply@repodna.dev>"
ALLOW_OTP_DEV_FALLBACK=false
